{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "http://82.70.210.206:3000/api/$1"
    },
    {
      "source": "/app",
      "destination": "/app/index.html"
    },
    {
      "source": "/download",
      "destination": "/app/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/nahagim.apk",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"nahagim-1.8.1.apk\"; filename*=UTF-8''%D7%A0%D7%94%D7%92%D7%99%D7%9D%201.8.1.apk"
        },
        {
          "key": "Content-Type",
          "value": "application/vnd.android.package-archive"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
